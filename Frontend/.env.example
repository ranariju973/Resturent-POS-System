# ---------------------------------------------------------------------------
# Frontend environment. Copy to .env.local (gitignored) if you need to override.
#
# NOTE: anything prefixed VITE_ is inlined into the browser bundle and is
# PUBLIC. Never put a secret, API key or password here.
# ---------------------------------------------------------------------------

# Leave EMPTY for normal development. Requests then go to the same origin and
# vite.config.ts proxies /api to the backend, which keeps the httpOnly refresh
# cookie same-site.
#
# Set this only to call a backend on a different origin — that backend's
# CORS_ORIGIN must then include this app's origin, and its refresh cookie
# sameSite setting has to be revisited.
VITE_API_URL=

# Where the dev proxy forwards /api. Change if the backend runs on another port.
# NOTE: 5001, not 5000 — on macOS the AirPlay Receiver service occupies 5000 and
# answers requests with a 403, which looks exactly like a broken backend.
VITE_PROXY_TARGET=http://localhost:5001
