# ---------------------------------------------------------------------------
# Kimche Restora POS — backend environment
#
# Copy to .env and fill in real values. NEVER commit .env.
# Every var marked REQUIRED is validated at boot by src/config/env.js — the
# process exits immediately if one is missing, rather than starting insecurely.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development                  # development | production | test

# 5001, not 5000: on macOS the AirPlay Receiver service (Control Center) holds
# port 5000 and answers with a 403, which looks just like a broken API.
PORT=5001

# --- Database (REQUIRED) ---------------------------------------------------
# Use a least-privilege database user in production, not a Mongo admin account.
MONGO_URI=mongodb://127.0.0.1:27017/verdant_pos

# --- JWT secrets (REQUIRED) ------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Access and refresh secrets MUST be different values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- PIN pepper (REQUIRED) -------------------------------------------------
# Peppers the deterministic staff-PIN lookup hash so a database dump alone
# cannot be brute-forced offline (a 4-digit PIN has only 10,000 values).
# Must differ from both JWT secrets. Generate the same way as above.
# WARNING: changing this after staff exist invalidates every stored PIN.
PIN_PEPPER=

# --- CORS (REQUIRED) -------------------------------------------------------
# Comma-separated allow-list of exact frontend origins. No wildcards.
#
# 8080 is the port the root `npm run dev` script serves the frontend on; 5173 is
# Vite's own default when you run it directly from the frontend directory. List
# every origin you actually use — the dev proxy strips the Origin header, so a
# missing entry here only shows up on requests that bypass the proxy, which
# makes it an easy problem to misdiagnose.
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# --- Cloudinary (REQUIRED) -------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Limits ----------------------------------------------------------------
JSON_BODY_LIMIT=100kb                 # general API payload cap
UPLOAD_MAX_BYTES=5242880              # 5MB — menu item image uploads only

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info                        # error | warn | info | debug

# --- Seed admin (used by `npm run seed` only) ------------------------------
# Not required for the server to boot. Change the password before seeding and
# do not reuse it anywhere else.
SEED_ADMIN_NAME=Aisha Verma
SEED_ADMIN_EMAIL=admin@verdantcafe.local
SEED_ADMIN_PASSWORD=
