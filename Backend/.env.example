# ─────────────────────────────────────────────────────────────────────────────
# Backend environment template.
#
# Copy to .env and fill in. Every value here is a placeholder — none of them
# will work as-is, and several are rejected outright by the validator.
#
# src/config/env.js validates all of this with Zod at boot and EXITS with a
# readable report if anything is missing or malformed. That file is the
# authority; this template just tells you what it will ask for.
#
# Generate each secret separately:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

# development | production | test          (default: development)
NODE_ENV=development
# 5001, not 5000 — macOS AirPlay Receiver holds 5000 and answers with a 403,
# which looks exactly like a dead API.
PORT=5001

# Must start with mongodb:// or mongodb+srv://.
# Order creation writes three documents in one transaction, so this must point
# at a REPLICA SET. Atlas gives you one on every tier; a standalone mongod
# silently degrades to non-atomic writes (loudly warned, but it still runs).
MONGO_URI=mongodb://127.0.0.1:27017/restaurant_pos

# ── Secrets ──────────────────────────────────────────────────────────────────
# All four must be at least 32 characters AND all four must differ from each
# other. env.js enforces both rules: reusing one key across two hashes means a
# single leak compromises both.

JWT_ACCESS_SECRET=replace-me-with-32+-random-chars-access
JWT_REFRESH_SECRET=replace-me-with-32+-random-chars-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Peppers the deterministic PIN lookup hash (src/models/User.js).
# Rotating this invalidates every stored PIN — staff must all re-set theirs.
# Treat as permanent once staff exist.
PIN_PEPPER=replace-me-with-32+-random-chars-pinpepper

# Peppers the public invoice-link token hash (src/models/Order.js).
# Rotating this breaks every receipt link already sent to a customer.
# Treat as permanent once a single bill has been shared.
INVOICE_TOKEN_PEPPER=replace-me-with-32+-random-chars-invoice

# Peppers the terminal device-binding token hash (src/models/Device.js).
# A terminal proves WHICH RESTAURANT it belongs to with this token — it is what
# stops one restaurant's staff PINs being matched against another's.
# Rotating this un-links every terminal; each needs an owner to link it again.
DEVICE_TOKEN_PEPPER=replace-me-with-32+-random-chars-device

# Every secret above must be a DIFFERENT value. The server refuses to start if
# any two match: reusing a key across the access and refresh signatures would
# let a refresh token be replayed as an access token, and reusing one across a
# signature and a hash pepper means one leak compromises both.
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Google Sign-In (admins) ──────────────────────────────────────────────────
# The OAuth 2.0 *Web application* client ID from console.cloud.google.com.
# Public by design — it is embedded in the frontend page.
#
# The client SECRET is deliberately not used anywhere in this project: admin ID
# tokens are verified against Google's published keys, so the secret plays no
# part in the flow. Do not add one.
#
# Authorised JavaScript origins must list every origin serving the frontend.
# Authorised redirect URIs stays EMPTY — Google Identity Services returns the
# token to the page, so there is no redirect.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com

# ── Origins ──────────────────────────────────────────────────────────────────
# Exact-match allow-list, comma-separated. No wildcards, no regex.
# In production the server REFUSES TO START if this contains "*" or localhost.
CORS_ORIGIN=http://localhost:8080

# Where the customer's browser opens — the FRONTEND origin, not the backend's.
# This is the host printed into WhatsApp receipt links. Optional in development
# (derived from the first CORS_ORIGIN); production refuses to boot without it.
PUBLIC_APP_URL=http://localhost:8080

# ── Cloudinary (menu item images) ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Limits and logging ───────────────────────────────────────────────────────
JSON_BODY_LIMIT=100kb
UPLOAD_MAX_BYTES=5242880
# error | warn | info | debug   — use info in production; debug logs request context
LOG_LEVEL=info

# ── Seeding only (npm run seed) ──────────────────────────────────────────────
# Read directly by src/scripts/seed.js, NOT part of the validated schema, so a
# missing value here fails at seed time rather than at boot.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-before-seeding
# Manager override PIN for discounts above the cashier ceiling and late voids.
SEED_ADMIN_OVERRIDE_PIN=0000
